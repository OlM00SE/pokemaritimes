# 10 "data/maps/HomeTown_Sawmill/scripts.pory"
	.string "The brook turned a wheel here once. Now\n"
	.string "the saw runs on its own engine.\p"
	.string "We cut the spruce from up in the hills.\n"
	.string "The old-timers floated the logs down\l"
	.string "the river; now it all goes out by truck\l"
	.string "to Woodstock.$"
