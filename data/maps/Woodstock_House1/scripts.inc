Woodstock_House1_EventScript_Mother_Text_0:
# 10 "data/maps/Woodstock_House1/scripts.pory"
	.string "Every spring, when the ice goes out on\n"
	.string "the river, half the town walks down to\l"
	.string "the bank to watch.\p"
	.string "It cracks like thunder, then the whole\n"
	.string "river starts to move!$"

Woodstock_House1_EventScript_Grandfather_Text_0:
# 15 "data/maps/Woodstock_House1/scripts.pory"
	.string "When I was a boy, the log drives came\n"
	.string "right down this river every spring.\p"
	.string "Thousands of logs, all the way to the\n"
	.string "mills downstream. You don't see that\l"
	.string "anymore.$"
