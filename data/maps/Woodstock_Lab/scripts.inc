Woodstock_Lab_EventScript_Chief_Text_0:
# 20 "data/maps/Woodstock_Lab/scripts.pory"
	.string "Welcome to the wildlife station! We keep\n"
	.string "track of the Pokémon that live along\l"
	.string "the river and in the woods.\p"
	.string "When the seasons turn, some Pokémon\n"
	.string "move up and down the valley. We're\l"
	.string "trying to learn where they go.$"

